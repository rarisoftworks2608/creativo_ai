SECRET_KEY=change-me
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to UTC if unset. Set this to match the timezone your team/clients actually
# work in - content_calendar.scheduled_time is a naive wall-clock value (e.g. "17:02"),
# compared against the server's local time as configured here, not against UTC. Leaving
# this on UTC while entering IST times means auto-generation fires ~5.5 hours off.
TIME_ZONE=Asia/Kolkata

# Example for PostgreSQL: postgres://user:password@localhost:5432/ai_management_system
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Console backend just prints emails to the server log - fine for local dev,
# but nothing actually reaches an inbox. Switch to smtp.EmailBackend + a real
# provider (e.g. Brevo, free tier) to send real welcome/reset emails:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<your Brevo account email>
#   EMAIL_HOST_PASSWORD=<your Brevo SMTP key, not your account password>
#   DEFAULT_FROM_EMAIL=<a sender verified in Brevo>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
FRONTEND_URL=http://localhost:5173

# AI Content Strategy (Epic 05) - leave ANTHROPIC_API_KEY/GROQ_API_KEY blank
# until you have one; the feature returns a clear 503 instead of crashing
# when it's unset. To use Groq instead of Anthropic, set:
#   AI_TEXT_PROVIDER=groq
#   AI_TEXT_MODEL=openai/gpt-oss-120b
#   GROQ_API_KEY=<your key from console.groq.com>
AI_TEXT_PROVIDER=anthropic
AI_TEXT_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# AI Creative Generation (Epic 06) - leave GEMINI_API_KEY blank until you have one;
# a queued generation request fails gracefully with a clear message when it's unset.
# Requires Redis running locally (see REDIS_URL) and a Celery worker:
#   celery -A config worker -l info --pool=solo
# To use Hugging Face instead - free, no card required, runs on HF's own
# serverless compute - set:
#   AI_IMAGE_PROVIDER=huggingface
#   AI_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers
#   HF_TOKEN=<your token from huggingface.co/settings/tokens, with the
#             "Inference Providers" permission>
# Free accounts get $0.10/month in Inference Provider credits (billed by
# compute time); check the actual balance at huggingface.co/settings/billing.
# To use Cloudflare Workers AI instead - the most generous free tier found so
# far, 10,000 free "Neurons"/day resetting daily (not monthly), runs FLUX.1
# [schnell] - set:
#   AI_IMAGE_PROVIDER=cloudflare
#   AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
#   CF_ACCOUNT_ID=<from your Cloudflare dashboard URL/sidebar>
#   CF_API_TOKEN=<an API token with "Workers AI - Read/Edit", from
#                 dash.cloudflare.com/profile/api-tokens>
AI_IMAGE_PROVIDER=gemini
AI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_API_KEY=
HF_TOKEN=
CF_ACCOUNT_ID=
CF_API_TOKEN=
AI_IMAGE_COST_PER_IMAGE_USD=
REDIS_URL=redis://localhost:6379/0

# AI Video Generation (Epic 07) - script + scenes use the text provider above,
# per-scene visuals use the image provider above (Cloudflare, OpenAI, ... -
# whichever AI_IMAGE_PROVIDER is active). Voice-over uses gTTS by default,
# which is free and needs no key. Rendering needs the `ffmpeg` binary installed
# separately and on PATH (not a pip package) - a queued request fails gracefully
# with a clear message if either an API key or ffmpeg itself is missing.
AI_VOICE_PROVIDER=gtts

# To switch image generation to OpenAI later (no other change needed - or pick it
# under Admin Settings > AI providers once the key is set):
#   AI_IMAGE_PROVIDER=openai
#   AI_IMAGE_MODEL=gpt-image-1
#   OPENAI_API_KEY=<from platform.openai.com/api-keys>
# OpenAI can also be the text provider: AI_TEXT_PROVIDER=openai, AI_TEXT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium

# AI motion clips for video scenes: huggingface (free monthly credit) or replicate (paid).
AI_VIDEO_PROVIDER=huggingface
AI_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
REPLICATE_API_TOKEN=

# Video rendering - full path to ffmpeg if it isn't on PATH (e.g. C:/ffmpeg/bin/ffmpeg.exe).
FFMPEG_BINARY=
VIDEO_CRF=23
VIDEO_PRESET=veryfast

# ---------------------------------------------------------------------------
# Publishing (Epic 11) - Instagram and WhatsApp DOWNLOAD media from a URL, so the
# media must be reachable from the internet. Production: your domain or S3/R2/CDN.
# Local development: run a tunnel, e.g. `cloudflared tunnel --url http://localhost:8000`,
# and put the https URL it prints here (BACKEND_PUBLIC_URL), or point
# PUBLIC_MEDIA_BASE_URL at a public bucket/CDN path that serves /media files.
# Facebook and LinkedIn upload the file directly and work without this.
BACKEND_PUBLIC_URL=http://localhost:8000
PUBLIC_MEDIA_BASE_URL=

# Social OAuth (Epic 10) - see docs/meta-setup-guide.md and docs/linkedin-setup-guide.md.
# Leave blank until the apps exist; accounts can still be connected by pasting a token.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
# Optional: Facebook Login for Business configuration ID (replaces the scope list).
META_LOGIN_CONFIG_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601
# Where Meta/LinkedIn send the browser back to - defaults to FRONTEND_URL. Register
#   <this>/oauth/callback/meta   and   <this>/oauth/callback/linkedin   in the apps.
SOCIAL_OAUTH_REDIRECT_BASE=

# WhatsApp Business Cloud API (Epic 12) - "console" logs messages instead of sending
# them. Switch to "meta" after creating the WhatsApp app (docs/meta-setup-guide.md part C).
WHATSAPP_PROVIDER=console
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
# Any random string - paste the same value into the Meta webhook settings.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Defaults to META_APP_SECRET; used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# Media storage (Epic 08) - local disk by default; S3 or Cloudflare R2 for production.
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# Public domain in front of the bucket (CDN), e.g. media.example.com
AWS_S3_CUSTOM_DOMAIN=

# Monitoring (Epic 26)
LOG_LEVEL=INFO
LOG_TO_FILE=False
SENTRY_DSN=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Production only (config.settings.production):
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True
