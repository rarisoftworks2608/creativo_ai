SECRET_KEY=change-me
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Example for PostgreSQL: postgres://user:password@localhost:5432/ai_management_system
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Console backend just prints emails to the server log - fine for local dev,
# but nothing actually reaches an inbox. Switch to smtp.EmailBackend + a real
# provider (e.g. Brevo, free tier) to send real welcome/reset emails:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=<your Brevo account email>
#   EMAIL_HOST_PASSWORD=<your Brevo SMTP key, not your account password>
#   DEFAULT_FROM_EMAIL=<a sender verified in Brevo>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
FRONTEND_URL=http://localhost:5173

# AI Content Strategy (Epic 05) - leave ANTHROPIC_API_KEY blank until you have one;
# the feature returns a clear 503 instead of crashing when it's unset.
AI_TEXT_PROVIDER=anthropic
AI_TEXT_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# AI Creative Generation (Epic 06) - leave GEMINI_API_KEY blank until you have one;
# a queued generation request fails gracefully with a clear message when it's unset.
# Requires Redis running locally (see REDIS_URL) and a Celery worker:
#   celery -A config worker -l info --pool=solo
AI_IMAGE_PROVIDER=gemini
AI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_API_KEY=
AI_IMAGE_COST_PER_IMAGE_USD=
REDIS_URL=redis://localhost:6379/0

# AI Video Generation (Epic 07) - script + scenes reuse ANTHROPIC_API_KEY above,
# per-scene visuals reuse GEMINI_API_KEY above. Voice-over uses gTTS by default,
# which is free and needs no key. Rendering needs the `ffmpeg` binary installed
# separately and on PATH (not a pip package) - a queued request fails gracefully
# with a clear message if either an API key or ffmpeg itself is missing.
AI_VOICE_PROVIDER=gtts
